{
  "name": "kathyuyen-tiktok-live-comments",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "REMOTE_BACKEND_MODE=1 node --env-file-if-exists=.env.local --watch server.js",
    "dev:remote": "npm run dev",
    "dev:local": "node --env-file-if-exists=.env.local scripts/run-local.js dev",
    "dev:live": "node --env-file-if-exists=.env.local scripts/run-local.js live",
    "test:local": "node --test test/local-*.test.js",
    "dev:collector": "node --env-file-if-exists=.env.local --watch server.js",
    "build": "node scripts/generate-runtime-config.js",
    "test": "node --test",
    "check:runtime": "node scripts/check-runtime.js",
    "audit:metadata": "node scripts/audit-metadata.js",
    "evaluate:classifier": "node scripts/evaluate-classifier.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "argon2": "^0.44.0",
    "express": "^5.1.0",
    "http-proxy": "^1.18.1",
    "socket.io": "^4.8.1",
    "tiktok-live-connector": "2.4.4"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
